{
  "appId": "com.olgrafik.app",
  "productName": "OL-Grafik",
  "beforePack": "scripts/rebuild-native.js",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "templates",
    "node_modules/grandiose/**/*",
    "!node_modules/grandiose/build/Release/.deps",
    "!node_modules/grandiose/build/Release/obj.target",
    "!node_modules/grandiose/**/*.{md,txt,yml,yaml}",
    "!node_modules/grandiose/examples/**/*",
    "!node_modules/grandiose/scratch/**/*"
  ],
  "asarUnpack": [
    "node_modules/grandiose/**/*"
  ],
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "nodeGypRebuild": false,
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.graphics-design",
    "icon": "build/icon.icns"
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Graphics",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}

