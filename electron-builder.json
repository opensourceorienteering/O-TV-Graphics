{
  "appId": "com.olgrafik.app",
  "productName": "Split Control",
  "beforePack": "scripts/rebuild-native.js",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "templates",
    "club-logos/**/*",
    "node_modules/@stagetimerio/grandiose/package.json",
    "node_modules/@stagetimerio/grandiose/dist/**/*",
    "companion/*.tgz"
  ],
  "asarUnpack": [
    "node_modules/@stagetimerio/grandiose/dist/**/*"
  ],
  "npmRebuild": false,
  "buildDependenciesFromSource": false,
  "nodeGypRebuild": false,
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.graphics-design",
    "icon": "resources/icon.icns"
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "resources/icon-win.png"
  },
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Graphics",
    "icon": "resources/icon-win.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
