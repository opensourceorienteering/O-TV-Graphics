{
  "name": "ol-grafik",
  "version": "1.1.0",
  "productName": "Split Control",
  "description": "Split Control: orienteering graphics for live broadcasts",
  "main": "dist-electron/main/index.js",
  "author": {
    "name": "Split Control",
    "email": "info@ol-grafik.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder",
    "rebuild:electron": "electron-rebuild -f -w @stagetimerio/grandiose",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "generate:sets": "node scripts/generate-template-sets.js",
    "logos:fetch": "env -u ELECTRON_RUN_AS_NODE electron scripts/fetch-club-logos.js",
    "logos:fetch:no": "npm run logos:fetch -- --country no",
    "logos:fetch:au": "npm run logos:fetch -- --country au",
    "test": "vitest",
    "postinstall": "node scripts/verify-grandiose.js",
    "companion:package": "npm run package --prefix companion"
  },
  "dependencies": {
    "@stagetimerio/grandiose": "^0.2.1",
    "ajv": "^8.20.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "rotating-file-stream": "^3.2.10",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3",
    "winston": "^3.19.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "@stagetimerio/grandiose@0.2.1": true,
    "electron-winstaller@5.4.0": true
  }
}
