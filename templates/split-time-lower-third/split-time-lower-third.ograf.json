{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "split-time-lower-third",
  "version": "1.0.0",
  "name": "Split Time Lower Third (mass start)",
  "description": "Lower third graphic displaying live split time results for mass start races. Shows the current leader (position 1) and the 4 bottom runners (last 4 positions) at a selected control point.",
  "author": {
    "name": "OL-Grafik",
    "email": "info@ol-grafik.com"
  },
  "main": "graphic.js",
  "schema": {
    "type": "object",
    "properties": {
      "className": {
        "type": "string",
        "title": "Class Name",
        "description": "The orienteering class name"
      },
      "controlCode": {
        "type": "string",
        "title": "Control Code",
        "description": "Control point code for split time display"
      },
      "controlName": {
        "type": "string",
        "title": "Control Name",
        "description": "Display name for the control point (e.g., 'Control 99')"
      },
      "results": {
        "type": "array",
        "title": "Results",
        "description": "Array of runner results at the split (OGRAF format)",
        "items": {
          "type": "object",
          "properties": {
            "position": {
              "type": ["string", "number"],
              "title": "Position at Split"
            },
            "name": {
              "type": "string",
              "title": "Runner Name"
            },
            "club": {
              "type": "string",
              "title": "Club"
            },
            "time": {
              "type": "string",
              "title": "Split Time"
            },
            "diff": {
              "type": "string",
              "title": "Time Behind Leader"
            },
            "status": {
              "type": "string",
              "title": "Status"
            },
            "statusCode": {
              "type": "number",
              "title": "Status Code"
            }
          }
        }
      }
    },
    "required": ["className", "controlCode", "results"]
  },
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1
}

