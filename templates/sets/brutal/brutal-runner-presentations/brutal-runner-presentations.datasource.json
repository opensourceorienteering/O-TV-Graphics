{
  "version": "1.0",
  "mode": "api",
  "api": {
    "provider": "liveresults",
    "fieldMappings": [
      {
        "templateField": "className",
        "apiPath": "className",
        "required": true,
        "autoPopulated": true,
        "allowOverride": true,
        "showInUI": true,
        "uiLabel": "Class name",
        "uiHelpText": "Override the class name shown"
      },
      {
        "templateField": "results",
        "apiPath": "results",
        "required": true,
        "autoPopulated": true,
        "allowOverride": false,
        "showInUI": false
      }
    ],
    "uiControls": [
      {
        "type": "class-selector",
        "label": "Class",
        "helpText": "Class to show",
        "required": true,
        "storeAs": "className",
        "compact": true
      }
    ],
    "fixedValues": {
      "controlCode": "Start"
    },
    "autoUpdate": {
      "defaultEnabled": false
    }
  }
}
