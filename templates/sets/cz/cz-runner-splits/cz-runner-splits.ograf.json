{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "cz-runner-splits",
  "version": "1.0.0",
  "name": "ČO – Split comparison",
  "description": "The selected runner at every radio control: place, places gained or lost, and time behind the best. In a relay, Team follows the runner's team through every leg and changeover.",
  "author": {
    "name": "Split Control"
  },
  "main": "graphic.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "compare": {
        "type": "string",
        "title": "Compare",
        "description": "The selected runner, or (relays) their team through every leg",
        "enum": [
          "runner",
          "team"
        ],
        "enumNames": [
          "Selected runner",
          "Team (all legs)"
        ],
        "default": "runner"
      },
      "maxControls": {
        "type": "number",
        "title": "Controls shown",
        "description": "Latest radio controls to show",
        "default": 6
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      }
    }
  ],
  "v_olgrafik_set": "cz",
  "v_olgrafik_kind": "runner-splits",
  "v_olgrafik_zone": "side"
}
