{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "sof-start-list",
  "version": "1.0.0",
  "name": "Svensk Orientering – Start list",
  "description": "Start list of a class with start times, paged.",
  "author": {
    "name": "Split Control"
  },
  "main": "graphic.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": -1,
  "schema": {
    "type": "object",
    "properties": {
      "rowsPerPage": {
        "type": "number",
        "title": "Rows per page",
        "description": "Runners per page",
        "default": 12
      }
    }
  },
  "customActions": [
    {
      "id": "next-page",
      "name": "Next page",
      "description": "Show the next page",
      "schema": null
    },
    {
      "id": "previous-page",
      "name": "Previous page",
      "description": "Show the previous page",
      "schema": null
    },
    {
      "id": "first-page",
      "name": "First page",
      "description": "Back to page 1",
      "schema": null
    }
  ],
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      }
    }
  ],
  "v_olgrafik_set": "sof",
  "v_olgrafik_kind": "start-list",
  "v_olgrafik_zone": "main"
}
