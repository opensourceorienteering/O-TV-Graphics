{
  "version": "1.0",
  "mode": "api",
  "api": {
    "provider": "liveresults",
    "fieldMappings": [
      {
        "templateField": "className",
        "apiPath": "className",
        "required": true,
        "autoPopulated": true,
        "allowOverride": true,
        "showInUI": true,
        "uiLabel": "Class name",
        "uiHelpText": "Override the class name shown"
      },
      {
        "templateField": "results",
        "apiPath": "results",
        "required": true,
        "autoPopulated": true,
        "allowOverride": false,
        "showInUI": false
      },
      {
        "templateField": "relayLegs",
        "apiPath": "relayLegs",
        "required": false,
        "autoPopulated": true,
        "allowOverride": false,
        "showInUI": false
      }
    ],
    "uiControls": [
      {
        "type": "class-selector",
        "label": "Class (a relay leg)",
        "helpText": "Any leg of the relay",
        "required": true,
        "storeAs": "className",
        "compact": true
      },
      {
        "type": "runner-search",
        "label": "Runner",
        "helpText": "Any runner of the team",
        "required": true,
        "storeAs": "runnerId",
        "searchBy": "both",
        "placeholder": "Name or bib...",
        "populateFields": {
          "runnerName": "name",
          "runnerClub": "club",
          "runnerBib": "bib"
        }
      }
    ]
  }
}
