{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "contours-podium",
  "version": "1.0.0",
  "name": "Contours – Podium",
  "description": "Flower ceremony / podium: places 1-3 in 2-1-3 order.",
  "author": {
    "name": "Split Control"
  },
  "main": "graphic.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title",
        "description": "Header text (default: class name)"
      },
      "showTime": {
        "type": "boolean",
        "title": "Show time",
        "description": "Finishing time under each name",
        "default": false
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      }
    }
  ],
  "v_olgrafik_set": "contours",
  "v_olgrafik_kind": "podium",
  "v_olgrafik_zone": "main"
}
