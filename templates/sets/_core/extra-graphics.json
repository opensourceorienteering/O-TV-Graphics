{
  "runner-presentations": {
    "name": "Runner presentations",
    "manifest": {
      "version": "1.0.0",
      "description": "Start list with operator-selected runners presented one at a time using Next and Previous.",
      "author": {
        "name": "Split Control"
      },
      "main": "graphic.js",
      "supportsRealTime": true,
      "supportsNonRealTime": false,
      "stepCount": -1,
      "schema": {
        "type": "object",
        "properties": {
          "rowsPerPage": {
            "type": "number",
            "title": "Rows per page",
            "description": "Runners per page",
            "default": 12
          },
          "highlightRunners": {
            "type": "array",
            "title": "Runners to present",
            "description": "Favourites are selected automatically. Tick or untick runners to override; Next follows start-list order.",
            "items": {
              "type": "string"
            },
            "v_olgrafik_control": "runner-multi-select",
            "v_olgrafik_default": "favourites"
          }
        }
      },
      "customActions": [
        {
          "id": "next-page",
          "name": "Next page",
          "description": "Focus the next selected runner or advance to the next start-list page",
          "schema": null
        },
        {
          "id": "previous-page",
          "name": "Previous page",
          "description": "Return to the previous focus or start-list page",
          "schema": null
        },
        {
          "id": "first-page",
          "name": "First page",
          "description": "Reset to the normal first start-list page",
          "schema": null
        }
      ],
      "renderRequirements": [
        {
          "resolution": {
            "width": {
              "ideal": 1920
            },
            "height": {
              "ideal": 1080
            }
          }
        }
      ],
      "v_olgrafik_kind": "runner-presentations",
      "v_olgrafik_zone": "main",
      "v_olgrafik_desk": {
        "label": "Runner presentations",
        "short": "Presentations",
        "inputs": [
          "class"
        ],
        "required": [
          "class"
        ],
        "fields": [
          "rowsPerPage",
          "highlightRunners"
        ],
        "feeds": [
          "timing"
        ],
        "behaviours": [
          "holdOnAir",
          "manualSteps"
        ],
        "previewData": "starts"
      }
    },
    "datasource": {
      "version": "1.0",
      "mode": "api",
      "api": {
        "provider": "liveresults",
        "fieldMappings": [
          {
            "templateField": "className",
            "apiPath": "className",
            "required": true,
            "autoPopulated": true,
            "allowOverride": true,
            "showInUI": true,
            "uiLabel": "Class name",
            "uiHelpText": "Override the class name shown"
          },
          {
            "templateField": "results",
            "apiPath": "results",
            "required": true,
            "autoPopulated": true,
            "allowOverride": false,
            "showInUI": false
          }
        ],
        "uiControls": [
          {
            "type": "class-selector",
            "label": "Class",
            "helpText": "Class to show",
            "required": true,
            "storeAs": "className",
            "compact": true
          }
        ],
        "fixedValues": {
          "controlCode": "Start"
        },
        "autoUpdate": {
          "defaultEnabled": false
        }
      }
    }
  },
  "finish-watch": {
    "name": "Finish watch",
    "manifest": {
      "version": "1.0.0",
      "description": "Prewarning-triggered race clocks, class and provisional placing; freezes at the finish or another radio and removes the runner after a hold.",
      "main": "graphic.js",
      "supportsRealTime": true,
      "supportsNonRealTime": false,
      "stepCount": 1,
      "schema": {
        "type": "object",
        "properties": {
          "triggerControl": {
            "type": "string",
            "title": "Prewarning control",
            "v_olgrafik_control": "radio-control"
          },
          "measureControl": {
            "type": "string",
            "title": "Measuring point",
            "v_olgrafik_control": "radio-control",
            "v_olgrafik_includeFinish": true,
            "v_olgrafik_distinctFrom": "triggerControl",
            "default": "F"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "holdSeconds": {
            "type": "number",
            "title": "Hold registered time (seconds)",
            "default": 4,
            "minimum": 0,
            "maximum": 30
          },
          "maxRows": {
            "type": "number",
            "title": "Maximum visible runners",
            "default": 8,
            "minimum": 1,
            "maximum": 12
          }
        },
        "required": [
          "triggerControl",
          "measureControl"
        ]
      },
      "v_olgrafik_kind": "finish-watch",
      "v_olgrafik_zone": "lower",
      "v_olgrafik_desk": {
        "label": "Finish watch",
        "short": "Finish watch",
        "inputs": [
          "class"
        ],
        "required": [],
        "fields": [
          "triggerControl",
          "measureControl",
          "title",
          "holdSeconds",
          "maxRows"
        ],
        "feeds": [
          "timing"
        ],
        "behaviours": [],
        "previewData": "splits"
      }
    },
    "datasource": {
      "version": "1.0",
      "mode": "api",
      "api": {
        "provider": "liveresults",
        "classScope": "optional",
        "fieldMappings": [
          {
            "templateField": "results",
            "apiPath": "results",
            "required": true,
            "autoPopulated": true,
            "allowOverride": false,
            "showInUI": false
          }
        ],
        "uiControls": [
          {
            "type": "class-selector",
            "label": "Class (optional)",
            "required": false,
            "storeAs": "className"
          }
        ]
      }
    }
  }
}
