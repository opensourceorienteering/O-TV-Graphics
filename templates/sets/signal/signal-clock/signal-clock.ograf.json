{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "signal-clock",
  "version": "1.0.0",
  "name": "Signal – Race clock",
  "description": "Countdown to a time (then counts up), time since a start, or time of day.",
  "author": {
    "name": "Split Control"
  },
  "main": "graphic.js",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
        "title": "Label",
        "description": "Text next to the clock, e.g. \"Mass start\""
      },
      "mode": {
        "type": "string",
        "title": "Mode",
        "enum": [
          "countdown",
          "elapsed",
          "time-of-day"
        ],
        "default": "countdown"
      },
      "time": {
        "type": "string",
        "title": "Time",
        "description": "HH:MM:SS (countdown target or start time)",
        "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
      }
    }
  },
  "renderRequirements": [
    {
      "resolution": {
        "width": {
          "ideal": 1920
        },
        "height": {
          "ideal": 1080
        }
      }
    }
  ],
  "v_olgrafik_set": "signal",
  "v_olgrafik_kind": "clock",
  "v_olgrafik_zone": "corner"
}
