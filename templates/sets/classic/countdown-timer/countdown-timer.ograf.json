{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "countdown-timer",
  "v_olgrafik_kind": "clock",
  "version": "1.0.0",
  "name": "Countdown/Countup Timer",
  "description": "Upper right corner timer that counts down to a target time, then automatically switches to count up mode. Displays operator-defined title and real-time timer updates.",
  "author": {
    "name": "Split Control"
  },
  "main": "graphic.js",
  "schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "title": "Title",
        "description": "Label text for the timer (e.g., 'Race Start', 'Next Wave')"
      },
      "targetTime": {
        "type": "string",
        "title": "Target Time",
        "description": "Target time in HH:MM:SS format (e.g., '11:30:00')",
        "pattern": "^([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
      }
    },
    "required": [
      "title",
      "targetTime"
    ]
  },
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "v_olgrafik_zone": "corner"
}
